# Phase 1 — NVIDIA hosted NIM (build.nvidia.com)
# Copy to .env and fill in. Never commit .env.

NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides (desktop defaults to integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct

# Recommended models on free build.nvidia.com credits (verified 2026-08):
#   meta/llama-3.1-8b-instruct              — fast smoke / settings test
#   nvidia/nemotron-3-nano-30b-a3b          — agentic workers (default NAT pattern)
#   nvidia/nemotron-3-super-120b-a12b       — long-context supervisor (slower cold start)
#   nvidia/nv-embedqa-e5-v5                 — RAG embeddings
