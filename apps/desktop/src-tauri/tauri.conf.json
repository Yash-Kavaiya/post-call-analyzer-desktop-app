{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Call Analyzer",
  "version": "0.1.0",
  "identifier": "com.callanalyzer.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Call Analyzer",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/whisper/Release/*": "vendor/whisper/Release/",
      "../../../examples/plugins/*": "examples/plugins/"
    }
  }
}
