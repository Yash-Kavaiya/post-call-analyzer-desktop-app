# ============================================================
# Call Analyzer — .gitattributes
#
# CI runs on both Windows and Linux runners. Without normalization,
# a file committed from Windows with CRLF fails `cargo fmt --check`
# on a Linux runner while passing locally, which is the single most
# confusing class of CI failure. Everything text is stored LF in the
# object database and checked out per the platform.
# Default: let Git detect text and normalize it to LF in the repo.
* text=auto eol=lf
# ── Explicit text types ──────────────────────────────────────
*.rs        text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.svg       text eol=lf
*.py        text eol=lf
# Windows-native tooling chokes on LF in these.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
# ── Binary: never diff, never normalize ──────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.bin       binary
*.dll       binary
*.exe       binary
*.lib       binary
*.pdb       binary
*.wasm      binary
*.db        binary
*.db-shm    binary
*.db-wal    binary
*.sqlite    binary
*.sqlite3   binary
*.wav       binary
*.mp3       binary
*.m4a       binary
*.flac      binary
*.ogg       binary
*.zip       binary
*.gz        binary
*.7z        binary
# ── Generated: collapse in review, exclude from language stats ──
Cargo.lock              linguist-generated=true -diff
package-lock.json       linguist-generated=true -diff
apps/desktop/src-tauri/gen/**  linguist-generated=true -diff
# Vendored binaries are a build input, not project source.
vendor/**   linguist-vendored=true
# ── Files that need not ship in a source archive ─────────────
.github/        export-ignore
docs/           export-ignore
scripts/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
models/ggml-small.en.bin filter=lfs diff=lfs merge=lfs -text
